# Transitional name for the absolute workbench artifact root outside Git.
# Store public-model caches, generated audio, and benchmark outputs here.
# Recording and private speaker data are not in the active project scope.
HMONG_TTS_DATA_ROOT=

# Optional absolute path outside the repository. One literal private identifier
# per line for local scanning; never commit this file or its contents.
HMONG_TTS_PII_DENYLIST=
