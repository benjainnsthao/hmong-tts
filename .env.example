# Absolute path outside this Git working tree. Store recordings, consent records,
# private evaluations, checkpoints, and generated audio below this root.
HMONG_TTS_DATA_ROOT=

# Optional absolute path outside the repository. One literal known private
# identifier per line; used only by the local privacy scan and never committed.
HMONG_TTS_PII_DENYLIST=

# Offline-by-default experiment tracking.
WANDB_MODE=offline
